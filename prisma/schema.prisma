generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  REQUESTER
  UNIT_MANAGER
  CONSIDERATION
  FINANCE_APPROVER
  GENERAL_AFFAIRS
  SUPERADMIN
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum ApprovalTargetType {
  UNIT_MANAGER
  ROLE
  USER
}

enum SubmissionStatus {
  DRAFT
  WAITING_UNIT_MANAGER
  WAITING_FINANCE
  NEEDS_REVISION
  APPROVED
  REJECTED
}

enum ApprovalStepStatus {
  PENDING
  COMPLETED
}

enum ApprovalActionType {
  APPROVED
  REJECTED
  REVISION_REQUESTED
  CONSIDERATION_GIVEN
  CONSIDERATION_REQUESTED
  EXPLANATION_REQUESTED
  EXPLANATION_GIVEN
  RESUBMITTED
  SUBMITTED
  EDITED
}

enum NotificationType {
  ACTION_REQUIRED
  STATUS_CHANGED
}

enum ConsiderationRequestStatus {
  PENDING
  RESPONDED
}

enum ExplanationRequestStatus {
  PENDING
  ANSWERED
}

model User {
  id              String               @id @default(uuid())
  username        String               @unique @db.VarChar(50)
  passwordHash    String
  name            String               @db.VarChar(160)
  roles           UserRole[]
  status          RecordStatus         @default(ACTIVE)
  unitId          String?
  unit            Unit?                @relation("UnitMembers", fields: [unitId], references: [id], onDelete: Restrict)
  managedUnits    Unit[]               @relation("UnitManager")
  sessions        Session[]
  submissions     Submission[]         @relation("RequesterSubmissions")
  actions         ApprovalAction[]
  notifications   Notification[]
  runStepTargets  SubmissionStep[]
  revisions       SubmissionRevision[]
  uploadedFiles   Attachment[]
  requestedConsiderations ConsiderationRequest[] @relation("ConsiderationRequestedBy")
  receivedConsiderations  ConsiderationRequest[] @relation("ConsiderationRecipient")
  requestedExplanations   ExplanationRequest[] @relation("ExplanationRequestedBy")
  receivedExplanations    ExplanationRequest[] @relation("ExplanationRecipient")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([unitId, status])
}

model UserRole {
  userId     String
  role       Role
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role, userId])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique @db.Char(64)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuthAttempt {
  keyHash         String   @id @db.Char(64)
  failedAttempts  Int      @default(0)
  windowStartedAt DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([windowStartedAt])
}

model Unit {
  id          String       @id @default(uuid())
  name        String       @unique @db.VarChar(120)
  status      RecordStatus @default(ACTIVE)
  managerId   String?
  manager     User?        @relation("UnitManager", fields: [managerId], references: [id], onDelete: SetNull)
  members     User[]       @relation("UnitMembers")
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Category {
  id          String       @id @default(uuid())
  name        String       @unique @db.VarChar(120)
  status      RecordStatus @default(ACTIVE)
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Submission {
  id            String               @id @default(uuid())
  number        String               @unique @db.VarChar(32)
  requesterId   String
  requester     User                 @relation("RequesterSubmissions", fields: [requesterId], references: [id], onDelete: Restrict)
  unitId        String
  unit          Unit                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  categoryId    String
  category      Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status        SubmissionStatus     @default(DRAFT)
  currentStepId String?
  currentStep   SubmissionStep?      @relation("CurrentStep", fields: [currentStepId], references: [id], onDelete: SetNull)
  items         SubmissionItem[]
  approvalSteps SubmissionStep[]     @relation("ApprovalSteps")
  actions       ApprovalAction[]
  revisions     SubmissionRevision[]
  attachments   Attachment[]
  notifications Notification[]
  considerationRequests ConsiderationRequest[]
  explanationRequests   ExplanationRequest[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  submittedAt   DateTime?
  approvedAt    DateTime?
  decidedAt     DateTime?

  @@unique([currentStepId])
  @@index([requesterId, createdAt])
  @@index([unitId, status, createdAt])
  @@index([categoryId, status])
  @@index([status, submittedAt])
}

model SubmissionItem {
  id            String     @id @default(uuid())
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  name          String     @db.VarChar(200)
  quantity      Int
  unitPrice     Decimal    @default(0) @db.Decimal(15, 2)
  description   String     @db.VarChar(1000)
  specification String     @default("") @db.VarChar(2000)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([submissionId])
}

model SubmissionStep {
  id             String             @id @default(uuid())
  submissionId   String
  submission     Submission         @relation("ApprovalSteps", fields: [submissionId], references: [id], onDelete: Cascade)
  currentFor     Submission?        @relation("CurrentStep")
  order          Int
  targetType     ApprovalTargetType
  targetRole     Role?
  targetUserId   String?
  targetUser     User?              @relation(fields: [targetUserId], references: [id], onDelete: Restrict)
  status         ApprovalStepStatus @default(PENDING)
  actions        ApprovalAction[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([submissionId, order])
  @@index([submissionId, status, order])
  @@index([targetUserId, status])
  @@index([targetRole, status])
}

model ApprovalAction {
  id               String             @id @default(uuid())
  submissionId     String
  submission       Submission         @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  submissionStepId String?
  submissionStep   SubmissionStep?    @relation(fields: [submissionStepId], references: [id], onDelete: SetNull)
  actorId          String
  actor            User               @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorRole        Role?
  action           ApprovalActionType
  note             String?            @db.VarChar(2000)
  resultingStatus  SubmissionStatus
  snapshot         Json?
  createdAt        DateTime           @default(now())

  @@index([submissionId, createdAt])
  @@index([actorId, createdAt])
}

model ConsiderationRequest {
  id          String                    @id @default(uuid())
  submissionId String
  submission   Submission                @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User                     @relation("ConsiderationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  recipientId   String
  recipient     User                     @relation("ConsiderationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  message       String                   @db.VarChar(2000)
  response      String?                  @db.VarChar(2000)
  status        ConsiderationRequestStatus @default(PENDING)
  respondedAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([submissionId, createdAt])
  @@index([recipientId, status, createdAt])
}

model ExplanationRequest {
  id            String                   @id @default(uuid())
  submissionId  String
  submission    Submission               @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User                     @relation("ExplanationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  recipientId   String
  recipient     User                     @relation("ExplanationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  question      String                   @db.VarChar(2000)
  answer        String?                  @db.VarChar(2000)
  status        ExplanationRequestStatus @default(PENDING)
  answeredAt    DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([submissionId, createdAt])
  @@index([recipientId, status, createdAt])
}

model SubmissionRevision {
  id           String     @id @default(uuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  version      Int
  snapshot     Json
  editedById   String
  editedBy     User       @relation(fields: [editedById], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())

  @@unique([submissionId, version])
  @@index([submissionId, createdAt])
}

model Attachment {
  id               String     @id @default(uuid())
  submissionId     String
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  originalFilename String     @db.VarChar(255)
  storageKey       String     @unique @db.VarChar(500)
  mimeType         String     @db.VarChar(120)
  sizeBytes        Int
  uploadedById     String
  uploadedBy       User       @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt        DateTime   @default(now())

  @@index([submissionId, createdAt])
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissionId String
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  type         NotificationType
  message      String           @db.VarChar(500)
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}
