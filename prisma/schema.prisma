generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  REQUESTER
  UNIT_MANAGER
  CONSIDERATION
  FINANCE_APPROVER
  GENERAL_AFFAIRS
  SUPERADMIN
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum WorkflowStepType {
  APPROVAL
  CONSIDERATION
}

enum WorkflowTargetType {
  UNIT_MANAGER
  ROLE
  USER
}

enum SubmissionStatus {
  DRAFT
  WAITING_UNIT_MANAGER
  WAITING_CONSIDERATION
  WAITING_APPROVAL
  WAITING_FINANCE
  NEEDS_REVISION
  APPROVED
  REJECTED
}

enum WorkflowStepStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum ApprovalActionType {
  APPROVED
  REJECTED
  REVISION_REQUESTED
  CONSIDERATION_GIVEN
  RESUBMITTED
  SUBMITTED
  EDITED
  SKIPPED
}

enum NotificationType {
  ACTION_REQUIRED
  STATUS_CHANGED
}

model User {
  id              String               @id @default(uuid()) @db.Uuid
  username        String               @unique @db.VarChar(50)
  passwordHash    String
  name            String               @db.VarChar(160)
  role            Role
  status          RecordStatus         @default(ACTIVE)
  unitId          String?              @db.Uuid
  unit            Unit?                @relation("UnitMembers", fields: [unitId], references: [id], onDelete: Restrict)
  managedUnits    Unit[]               @relation("UnitManager")
  sessions        Session[]
  submissions     Submission[]         @relation("RequesterSubmissions")
  actions         ApprovalAction[]
  notifications   Notification[]
  workflowTargets WorkflowStep[]       @relation("WorkflowUserTarget")
  runStepTargets  SubmissionStep[]
  revisions       SubmissionRevision[]
  uploadedFiles   Attachment[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([unitId, role, status])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @db.Char(64)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuthAttempt {
  keyHash         String   @id @db.Char(64)
  failedAttempts  Int      @default(0)
  windowStartedAt DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([windowStartedAt])
}

model Unit {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique @db.VarChar(120)
  status      RecordStatus @default(ACTIVE)
  managerId   String?      @db.Uuid
  manager     User?        @relation("UnitManager", fields: [managerId], references: [id], onDelete: SetNull)
  members     User[]       @relation("UnitMembers")
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Category {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique @db.VarChar(120)
  status      RecordStatus @default(ACTIVE)
  workflow    Workflow?
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Workflow {
  id         String         @id @default(uuid()) @db.Uuid
  name       String         @db.VarChar(120)
  status     RecordStatus   @default(ACTIVE)
  categoryId String         @unique @db.Uuid
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  steps      WorkflowStep[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model WorkflowStep {
  id            String             @id @default(uuid()) @db.Uuid
  workflowId    String             @db.Uuid
  workflow      Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  order         Int
  type          WorkflowStepType
  targetType    WorkflowTargetType
  targetRole    Role?
  targetUserId  String?            @db.Uuid
  targetUser    User?              @relation("WorkflowUserTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  required      Boolean            @default(true)
  allowRevision Boolean            @default(false)
  runSteps      SubmissionStep[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([workflowId, order])
  @@index([workflowId, order])
}

model Submission {
  id            String               @id @default(uuid()) @db.Uuid
  number        String               @unique @db.VarChar(32)
  requesterId   String               @db.Uuid
  requester     User                 @relation("RequesterSubmissions", fields: [requesterId], references: [id], onDelete: Restrict)
  unitId        String               @db.Uuid
  unit          Unit                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  categoryId    String               @db.Uuid
  category      Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  purpose       String               @db.VarChar(2000)
  status        SubmissionStatus     @default(DRAFT)
  currentStepId String?              @db.Uuid
  currentStep   SubmissionStep?      @relation("CurrentStep", fields: [currentStepId], references: [id], onDelete: SetNull)
  items         SubmissionItem[]
  workflowSteps SubmissionStep[]     @relation("SubmissionSteps")
  actions       ApprovalAction[]
  revisions     SubmissionRevision[]
  attachments   Attachment[]
  notifications Notification[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  submittedAt   DateTime?
  approvedAt    DateTime?
  decidedAt     DateTime?

  @@unique([currentStepId])
  @@index([requesterId, createdAt])
  @@index([unitId, status, createdAt])
  @@index([categoryId, status])
  @@index([status, submittedAt])
}

model SubmissionItem {
  id           String     @id @default(uuid()) @db.Uuid
  submissionId String     @db.Uuid
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  name         String     @db.VarChar(200)
  quantity     Int
  description  String     @db.VarChar(1000)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([submissionId])
}

model SubmissionStep {
  id             String             @id @default(uuid()) @db.Uuid
  submissionId   String             @db.Uuid
  submission     Submission         @relation("SubmissionSteps", fields: [submissionId], references: [id], onDelete: Cascade)
  currentFor     Submission?        @relation("CurrentStep")
  workflowStepId String?            @db.Uuid
  workflowStep   WorkflowStep?      @relation(fields: [workflowStepId], references: [id], onDelete: SetNull)
  order          Int
  type           WorkflowStepType
  targetType     WorkflowTargetType
  targetRole     Role?
  targetUserId   String?            @db.Uuid
  targetUser     User?              @relation(fields: [targetUserId], references: [id], onDelete: Restrict)
  required       Boolean            @default(true)
  allowRevision  Boolean            @default(false)
  status         WorkflowStepStatus @default(PENDING)
  actions        ApprovalAction[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([submissionId, order])
  @@index([submissionId, status, order])
  @@index([targetUserId, status])
  @@index([targetRole, status])
}

model ApprovalAction {
  id               String             @id @default(uuid()) @db.Uuid
  submissionId     String             @db.Uuid
  submission       Submission         @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  submissionStepId String?            @db.Uuid
  submissionStep   SubmissionStep?    @relation(fields: [submissionStepId], references: [id], onDelete: SetNull)
  actorId          String             @db.Uuid
  actor            User               @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action           ApprovalActionType
  note             String?            @db.VarChar(2000)
  resultingStatus  SubmissionStatus
  snapshot         Json?
  createdAt        DateTime           @default(now())

  @@index([submissionId, createdAt])
  @@index([actorId, createdAt])
}

model SubmissionRevision {
  id           String     @id @default(uuid()) @db.Uuid
  submissionId String     @db.Uuid
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  version      Int
  snapshot     Json
  editedById   String     @db.Uuid
  editedBy     User       @relation(fields: [editedById], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())

  @@unique([submissionId, version])
  @@index([submissionId, createdAt])
}

model Attachment {
  id               String     @id @default(uuid()) @db.Uuid
  submissionId     String     @db.Uuid
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  originalFilename String     @db.VarChar(255)
  storageKey       String     @unique @db.VarChar(500)
  mimeType         String     @db.VarChar(120)
  sizeBytes        Int
  uploadedById     String     @db.Uuid
  uploadedBy       User       @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt        DateTime   @default(now())

  @@index([submissionId, createdAt])
}

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissionId String           @db.Uuid
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  type         NotificationType
  message      String           @db.VarChar(500)
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}
